[Unit]
Description=Books A-share closing collection and precomputation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=books
Group=books
WorkingDirectory=/opt/books/app
Environment=BOOKS_SITE_DIR=/opt/books/site
Environment=BOOKS_A_SHARE_DIR=/var/lib/books/a-share-daily
Environment=BOOKS_DB=/var/lib/books/books.sqlite
ExecStart=/usr/bin/node /opt/books/app/a-share-daily.mjs
TimeoutStartSec=6h
Nice=10
