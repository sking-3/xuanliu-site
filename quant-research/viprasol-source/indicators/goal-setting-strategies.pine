                  text_color=vip_label_color, bgcolor=vip_panel_color, text_size=vip_milestone_size)
        vip_row += 1

    //───────────────────────────────────────────────────────
    // 5. ELITE DASHBOARD - PROGRESS COUNTER
    //───────────────────────────────────────────────────────
    
    vip_phases_achieved = (vip_milestone1_complete and vip_total_goals >= 1 ? 1 : 0) + 
                          (vip_milestone2_complete and vip_total_goals >= 2 ? 1 : 0) + 
                          (vip_milestone3_complete and vip_total_goals >= 3 ? 1 : 0) + 
                          (vip_milestone4_complete and vip_total_goals >= 4 ? 1 : 0) +
                          (vip_milestone5_complete and vip_total_goals >= 5 ? 1 : 0) +
                          (vip_milestone6_complete and vip_total_goals >= 6 ? 1 : 0) +
                          (vip_milestone7_complete and vip_total_goals >= 7 ? 1 : 0) +
                          (vip_milestone8_complete and vip_total_goals >= 8 ? 1 : 0) +
                          (vip_milestone9_complete and vip_total_goals >= 9 ? 1 : 0) +
                          (vip_milestone10_complete and vip_total_goals >= 10 ? 1 : 0) +
                          (vip_milestone11_complete and vip_total_goals >= 11 ? 1 : 0) +
                          (vip_milestone12_complete and vip_total_goals >= 12 ? 1 : 0) +
                          (vip_milestone13_complete and vip_total_goals >= 13 ? 1 : 0) +
                          (vip_milestone14_complete and vip_total_goals >= 14 ? 1 : 0) +
                          (vip_milestone15_complete and vip_total_goals >= 15 ? 1 : 0) +
                          (vip_milestone16_complete and vip_total_goals >= 16 ? 1 : 0) +
                          (vip_milestone17_complete and vip_total_goals >= 17 ? 1 : 0) +
                          (vip_milestone18_complete and vip_total_goals >= 18 ? 1 : 0) +
                          (vip_milestone19_complete and vip_total_goals >= 19 ? 1 : 0) +
                          (vip_milestone20_complete and vip_total_goals >= 20 ? 1 : 0)
    
    vip_progress_display = "🚀 VIPRASOL PROGRESS: " + str.tostring(vip_phases_achieved) + "/" + str.tostring(vip_total_goals) + " Phases Achieved"
    
    table.cell(vip_elite_dashboard, 0, vip_row, 
              vip_progress_display, 
              text_color=vip_achievement_color, 
              bgcolor=color.new(vip_panel_color, 60), 
              text_size=vip_milestone_size, 
              text_halign=text.align_center)
