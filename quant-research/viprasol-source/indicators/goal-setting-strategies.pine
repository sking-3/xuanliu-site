//@version=5
indicator("Goal Setting Strategies Viprasol", overlay=true, max_labels_count=500)
// © viprasol

//───────────────────────────────────────────────────────
// 1. VIPRASOL CONFIGURATION
//───────────────────────────────────────────────────────

// 🎯 GOAL SETUP
vip_goal_name = input.string("Elite Trading Goal", "Primary Goal", group="🎯 Viprasol Goal Configuration", tooltip="Define your main trading objective")
