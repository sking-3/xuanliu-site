vip_milestone15_complete = input.bool(false, "✓ Goal 15", group="📋 Goal Definitions")

// 💫 MILESTONE 16
vip_milestone16_name = input.string("Milestone 16", "Goal 16 💫", group="📋 Goal Definitions")
vip_milestone16_complete = input.bool(false, "✓ Goal 16", group="📋 Goal Definitions")

// ✨ MILESTONE 17
vip_milestone17_name = input.string("Milestone 17", "Goal 17 ✨", group="📋 Goal Definitions")
vip_milestone17_complete = input.bool(false, "✓ Goal 17", group="📋 Goal Definitions")

// 🌠 MILESTONE 18
vip_milestone18_name = input.string("Milestone 18", "Goal 18 🌠", group="📋 Goal Definitions")
vip_milestone18_complete = input.bool(false, "✓ Goal 18", group="📋 Goal Definitions")

// 🔱 MILESTONE 19
