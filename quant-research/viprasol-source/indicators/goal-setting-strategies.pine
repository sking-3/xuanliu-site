// 💪 MILESTONE 12
vip_milestone12_name = input.string("Milestone 12", "Goal 12 💪", group="📋 Goal Definitions")
vip_milestone12_complete = input.bool(false, "✓ Goal 12", group="📋 Goal Definitions")

// 🏆 MILESTONE 13
vip_milestone13_name = input.string("Milestone 13", "Goal 13 🏆", group="📋 Goal Definitions")
vip_milestone13_complete = input.bool(false, "✓ Goal 13", group="📋 Goal Definitions")

