vip_milestone20_complete = input.bool(false, "✓ Goal 20", group="📋 Goal Definitions")

//───────────────────────────────────────────────────────
// 2. PREMIUM STYLING
//───────────────────────────────────────────────────────

vip_header_color = input.color(color.new(#00E5FF, 0), "Goal Header Color", group="🌈 Premium Styling")
vip_label_color = input.color(color.white, "Label Color", group="🌈 Premium Styling")
vip_panel_color = input.color(color.new(#1a1a2e, 0), "Panel Background", group="🌈 Premium Styling")
vip_achievement_color = input.color(color.new(#00FFA3, 0), "Achievement Color", group="🌈 Premium Styling")

vip_header_size = input.string("normal", "Header Font Size", options=["tiny", "small", "normal", "large", "huge"], group="🌈 Premium Styling")
vip_milestone_size = input.string("small", "Milestone Font Size", options=["tiny", "small", "normal", "large", "huge"], group="🌈 Premium Styling")

// 📍 ELITE DISPLAY POSITION
vip_panel_position = input.string("Bottom Left", "Dashboard Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group="📍 Elite Display")
vip_display_pos = switch vip_panel_position
    "Top Left" => position.top_left
    "Top Right" => position.top_right
    "Bottom Left" => position.bottom_left
    "Bottom Right" => position.bottom_right

//───────────────────────────────────────────────────────
// 3. CORE CALCULATIONS
//───────────────────────────────────────────────────────

// ✅ STATUS INDICATOR FUNCTION
vip_status_icon(_achieved) =>
    _achieved ? "✅" : "⬜️"

//───────────────────────────────────────────────────────
// 4. VISUAL SYSTEM
//───────────────────────────────────────────────────────

var table vip_elite_dashboard = table.new(vip_display_pos, 1, 22, border_width=2, frame_color=color.new(#9D4EDD, 30))

if barstate.islast
    // 🎯 VIPRASOL ELITE HEADER
    table.cell(vip_elite_dashboard, 0, 0, "🎯 VIPRASOL ELITE: " + vip_goal_name, 
              text_color=vip_label_color, 
              bgcolor=vip_header_color, 
              text_size=vip_header_size, 
              text_halign=text.align_center)

    // 📊 MILESTONE TRACKING - Dynamic Display
    vip_row = 1
    
    if vip_total_goals >= 1
        table.cell(vip_elite_dashboard, 0, vip_row, 
                  "♣️ " + vip_milestone1_name + "  " + vip_status_icon(vip_milestone1_complete), 
                  text_color=vip_label_color, bgcolor=vip_panel_color, text_size=vip_milestone_size)
        vip_row += 1
    
    if vip_total_goals >= 2
        table.cell(vip_elite_dashboard, 0, vip_row, 
                  "♠️ " + vip_milestone2_name + "  " + vip_status_icon(vip_milestone2_complete), 
                  text_color=vip_label_color, bgcolor=vip_panel_color, text_size=vip_milestone_size)
        vip_row += 1
    
    if vip_total_goals >= 3
        table.cell(vip_elite_dashboard, 0, vip_row, 
                  "♥️ " + vip_milestone3_name + "  " + vip_status_icon(vip_milestone3_complete), 
                  text_color=vip_label_color, bgcolor=vip_panel_color, text_size=vip_milestone_size)
        vip_row += 1
    
    if vip_total_goals >= 4
        table.cell(vip_elite_dashboard, 0, vip_row, 
                  "♦️ " + vip_milestone4_name + "  " + vip_status_icon(vip_milestone4_complete), 
                  text_color=vip_label_color, bgcolor=vip_panel_color, text_size=vip_milestone_size)
        vip_row += 1
    
    if vip_total_goals >= 5
        table.cell(vip_elite_dashboard, 0, vip_row, 
                  "🌟 " + vip_milestone5_name + "  " + vip_status_icon(vip_milestone5_complete), 
                  text_color=vip_label_color, bgcolor=vip_panel_color, text_size=vip_milestone_size)
        vip_row += 1
    
    if vip_total_goals >= 6
        table.cell(vip_elite_dashboard, 0, vip_row, 
                  "⭐ " + vip_milestone6_name + "  " + vip_status_icon(vip_milestone6_complete), 
                  text_color=vip_label_color, bgcolor=vip_panel_color, text_size=vip_milestone_size)
        vip_row += 1
    
    if vip_total_goals >= 7
        table.cell(vip_elite_dashboard, 0, vip_row, 
                  "💎 " + vip_milestone7_name + "  " + vip_status_icon(vip_milestone7_complete), 
                  text_color=vip_label_color, bgcolor=vip_panel_color, text_size=vip_milestone_size)
        vip_row += 1
    
    if vip_total_goals >= 8
        table.cell(vip_elite_dashboard, 0, vip_row, 
                  "🎯 " + vip_milestone8_name + "  " + vip_status_icon(vip_milestone8_complete), 
                  text_color=vip_label_color, bgcolor=vip_panel_color, text_size=vip_milestone_size)
        vip_row += 1
    
    if vip_total_goals >= 9
        table.cell(vip_elite_dashboard, 0, vip_row, 
                  "🔥 " + vip_milestone9_name + "  " + vip_status_icon(vip_milestone9_complete), 
                  text_color=vip_label_color, bgcolor=vip_panel_color, text_size=vip_milestone_size)
        vip_row += 1
    
    if vip_total_goals >= 10
        table.cell(vip_elite_dashboard, 0, vip_row, 
                  "⚡ " + vip_milestone10_name + "  " + vip_status_icon(vip_milestone10_complete), 
                  text_color=vip_label_color, bgcolor=vip_panel_color, text_size=vip_milestone_size)
        vip_row += 1
    
    if vip_total_goals >= 11
        table.cell(vip_elite_dashboard, 0, vip_row, 
                  "🚀 " + vip_milestone11_name + "  " + vip_status_icon(vip_milestone11_complete), 
                  text_color=vip_label_color, bgcolor=vip_panel_color, text_size=vip_milestone_size)
        vip_row += 1
    
    if vip_total_goals >= 12
        table.cell(vip_elite_dashboard, 0, vip_row, 
                  "💪 " + vip_milestone12_name + "  " + vip_status_icon(vip_milestone12_complete), 
                  text_color=vip_label_color, bgcolor=vip_panel_color, text_size=vip_milestone_size)
        vip_row += 1
    
    if vip_total_goals >= 13
        table.cell(vip_elite_dashboard, 0, vip_row, 
                  "🏆 " + vip_milestone13_name + "  " + vip_status_icon(vip_milestone13_complete), 
                  text_color=vip_label_color, bgcolor=vip_panel_color, text_size=vip_milestone_size)
        vip_row += 1
    
    if vip_total_goals >= 14
        table.cell(vip_elite_dashboard, 0, vip_row, 
                  "🎖️ " + vip_milestone14_name + "  " + vip_status_icon(vip_milestone14_complete), 
                  text_color=vip_label_color, bgcolor=vip_panel_color, text_size=vip_milestone_size)
        vip_row += 1
    
    if vip_total_goals >= 15
        table.cell(vip_elite_dashboard, 0, vip_row, 
                  "👑 " + vip_milestone15_name + "  " + vip_status_icon(vip_milestone15_complete), 
                  text_color=vip_label_color, bgcolor=vip_panel_color, text_size=vip_milestone_size)
        vip_row += 1
    
    if vip_total_goals >= 16
        table.cell(vip_elite_dashboard, 0, vip_row, 
                  "💫 " + vip_milestone16_name + "  " + vip_status_icon(vip_milestone16_complete), 
                  text_color=vip_label_color, bgcolor=vip_panel_color, text_size=vip_milestone_size)
        vip_row += 1
    
    if vip_total_goals >= 17
        table.cell(vip_elite_dashboard, 0, vip_row, 
                  "✨ " + vip_milestone17_name + "  " + vip_status_icon(vip_milestone17_complete), 
                  text_color=vip_label_color, bgcolor=vip_panel_color, text_size=vip_milestone_size)
        vip_row += 1
    
    if vip_total_goals >= 18
        table.cell(vip_elite_dashboard, 0, vip_row, 
                  "🌠 " + vip_milestone18_name + "  " + vip_status_icon(vip_milestone18_complete), 
                  text_color=vip_label_color, bgcolor=vip_panel_color, text_size=vip_milestone_size)
        vip_row += 1
    
    if vip_total_goals >= 19
        table.cell(vip_elite_dashboard, 0, vip_row, 
                  "🔱 " + vip_milestone19_name + "  " + vip_status_icon(vip_milestone19_complete), 
